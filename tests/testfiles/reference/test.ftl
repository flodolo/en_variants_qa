# Identical in the localization
identical-string = Settings
# Differs only by case in the localization
case-difference = Add-ons
# Differs only by case, but listed in the exclusions file
case-exception = Bookmarks
# Expected spelling change (Color -> Colour)
spelling-change = Color
# Unexpected change in the localization
spelling-difference = Downloads
# Unexpected change, but listed in the exclusions file
spelling-exception = History
# Accesskeys are compared case-insensitively
accesskey-string =
    .label = Analyze
    .accesskey = A
# Value and attributes are both extracted
value-and-attributes = Behavior
    .tooltiptext = Customize the dialog
# The value is empty, only attributes are extracted
empty-value =
    .label = Favorites
# DATETIME options are normalized when serializing
datetime-options = { DATETIME($date, month: "short", day: "numeric") }
